# Environment Variables for TDoc Crawler
# =======================================
# This file documents supported environment variables (see
# src/tdoc_crawler/config/env_vars.py for the authoritative list).
# For configuration file approach, see docs/config.md
#
# Copy to .env and replace values:
#   cp .env.example .env

# ============================================================================
# PATH CONFIGURATION
# ============================================================================

# Cache directory for storing downloaded metadata and files (default: ~/.3gpp-crawler)
# The database (3gpp_crawler.db), HTTP cache, and checkout/ are derived from it.
# TDC_CACHE_DIR=~/.3gpp-crawler

# ============================================================================
# ETSI ONLINE (EOL) CREDENTIALS
# ============================================================================
# Required for accessing protected 3GPP portal resources
# Sign up at: https://portal.etsi.org/

# Your ETSI Online username
TDC_EOL_USERNAME=

# Your ETSI Online password
TDC_EOL_PASSWORD=

# Custom prompt message for interactive credential entry
# TDC_EOL_PROMPT=

# ============================================================================
# HTTP SETTINGS
# ============================================================================

# HTTP request timeout in seconds (default: 30)
TDC_TIMEOUT=30

# Verify SSL certificates for HTTPS requests (default: true)
# TDC_VERIFY_SSL=true

# Maximum number of retry attempts for failed requests (default: 3)
TDC_MAX_RETRIES=3

# Enable HTTP response caching (default: true)
# HTTP_CACHE_ENABLED=true

# Time-to-live for cached HTTP responses in seconds (default: 7200 = 2 hours)
# HTTP_CACHE_TTL=7200

# ============================================================================
# CRAWL FILTER CONFIGURATION
# ============================================================================

# Filter by working group: RAN, SA, or CT (repeatable on the CLI)
# TDC_WORKING_GROUP=SA

# Filter by sub-working group (e.g., S4, R1)
# TDC_SUB_GROUP=

# Start date filter (YYYY, YYYY-MM, or YYYY-MM-DD format)
# TDC_START_DATE=2024-01-01

# End date filter (YYYY, YYYY-MM, or YYYY-MM-DD format)
# TDC_END_DATE=2024-12-31

# Glob pattern to match document source
# TDC_SOURCE_PATTERN=

# Glob pattern to match agenda item
# TDC_AGENDA_PATTERN=

# Glob pattern to match document title
# TDC_TITLE_PATTERN=

# Maximum number of documents to crawl (default: 1000)
# TDC_LIMIT_TDOCS=1000

# Maximum meetings to crawl overall (negative = newest N)
# TDC_LIMIT_MEETINGS=

# Per sub-WG meeting limit (negative = newest N)
# TDC_LIMIT_MEETINGS_PER_SUBWG=

# Number of parallel subinterpreter workers (default: 4)
TDC_WORKERS=4

# ============================================================================
# MAIN-DOCUMENT SELECTION
# ============================================================================
# How `tdoc open` picks the main document inside a TDoc zip. A stored manual
# override (`tdoc main-file set`) always wins.

# Strategy: heuristic (default), decision_model, or manual
# TDC_CHECKOUT_SELECTOR=heuristic

# TypeSafe System One settings (only used with decision_model)
# TDC_CHECKOUT_SYSTEMONE_API_KEY=
# TDC_CHECKOUT_SYSTEMONE_BASE_URL=https://api.typesafe.ai
# TDC_CHECKOUT_SYSTEMONE_MODEL=jev-latest
# TDC_CHECKOUT_SYSTEMONE_MIN_CONFIDENCE=0.7

# ============================================================================
# ADDITIONAL SERVICES
# ============================================================================

# Hugging Face API Token
# Recommended for authentication with Hugging Face Hub to avoid rate limits
# when downloading models and datasets.
# Sign up at: https://huggingface.co/
# HF_TOKEN=


# ============================================================================
# NOTE
# ============================================================================
# For full configuration documentation, see: docs/config.md
