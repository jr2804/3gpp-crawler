	"version": "0.2.0",
	"configurations": [

		{
			"name": "Debug: ai query",
			"type": "debugpy",
			"request": "launch",
			"module": "tdoc_crawler",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"query",
				"Can you provide a summary of the test methods for IVAS-capable devices?",
			]
		},
		{
			"name": "Debug: ai workspace process",
			"type": "debugpy",
			"request": "launch",
			"program": "packages/3gpp-ai/threegpp_ai/cli.py",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"workspace",
				"process",
			]
		},
		{
			"name": "Debug: meetings crawl (max. 5)",
			"type": "debugpy",
			"request": "launch",
			"module": "tdoc_crawler.cli.meetings_app",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"crawl",
				"--cache-dir",
				"./tests/test-cache",
				"--limit-meetings",
				"5"
			]
		},
		{
			"name": "Debug: meetings crawl (full)",
			"type": "debugpy",
			"request": "launch",
			"module": "tdoc_crawler.cli.meetings_app",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"crawl",
				"--cache-dir",
				"./tests/test-cache"
			]
		},
		{
			"name": "Debug: meetings crawl (single WG)",
			"type": "debugpy",
			"request": "launch",
			"module": "tdoc_crawler.cli.meetings_app",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"crawl",
				"--cache-dir",
				"./tests/test-cache",
				"--limit-wgs",
				"1",
				"--limit-meetings",
				"10"
			]
		},
		{
			"name": "Debug: meetings query",
			"type": "debugpy",
			"request": "launch",
			"module": "tdoc_crawler.cli.meetings_app",
			"console": "integratedTerminal",
			"justMyCode": false,
			"args": [
				"query",
				"--cache-dir",
				"./tests/test-cache"
			]
		},
		{
			"name": "Debug: meetings query (specific WG - SA)",
